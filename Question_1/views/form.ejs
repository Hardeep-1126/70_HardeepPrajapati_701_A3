<!DOCTYPE html>
<html>

<head>

    <title>Registration Form</title>

</head>

<body>

<h1>User Registration</h1>


<!-- Show Errors -->

<% if (errors.length > 0) { %>

    <ul>

        <% errors.forEach(function(error) { %>

            <li style="color:red">

                <%= error.msg %>

            </li>

        <% }) %>

    </ul>

<% } %>


<form
    action="/register"
    method="POST"
    enctype="multipart/form-data"
>


    Username:

    <input
        type="text"
        name="username"
        value="<%= oldData.username || '' %>"
    >

    <br><br>


    Password:

    <input
        type="password"
        name="password"
    >

    <br><br>


    Confirm Password:

    <input
        type="password"
        name="confirmPassword"
    >

    <br><br>


    Email:

    <input
        type="text"
        name="email"
        value="<%= oldData.email || '' %>"
    >

    <br><br>


    Gender:

    <input
        type="radio"
        name="gender"
        value="Male"
    >

    Male


    <input
        type="radio"
        name="gender"
        value="Female"
    >

    Female

    <br><br>


    Hobbies:

    <input
        type="checkbox"
        name="hobbies"
        value="Reading"
    >

    Reading


    <input
        type="checkbox"
        name="hobbies"
        value="Gaming"
    >

    Gaming


    <input
        type="checkbox"
        name="hobbies"
        value="Music"
    >

    Music

    <br><br>


    Profile Picture:

    <input
        type="file"
        name="profilePic"
    >

    <br><br>


    Other Pictures:

    <input
        type="file"
        name="otherPics"
        multiple
    >

    <br><br>


    <button type="submit">

        Register

    </button>


</form>

</body>

</html>